#!/data/data/com.termux/files/usr/bin/bash
# HACK-LOCK :: skin + command
# Running 'hacklock' (or opening a new Termux session) applies a simple
# visual skin to the REAL Termux: black background, green text / prompt /
# cursor, and a wallpaper header. Nothing else changes.
# All normal Termux commands keep working exactly as before.

set -u

HACKLOCK_VERSION="1.0.0"
HACKLOCK_DIR="${HACKLOCK_DIR:-$HOME/.hacklock}"

CONFIG_FILE="$HACKLOCK_DIR/config/config.sh"
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

HACKLOCK_GREEN="${HACKLOCK_GREEN:-#00ff41}"
HACKLOCK_HEADER_HEIGHT="${HACKLOCK_HEADER_HEIGHT:-0}"
HACKLOCK_USER_TEXT="${HACKLOCK_USER_TEXT:-HACK-LOCK}"
HACKLOCK_WALLPAPER="${HACKLOCK_WALLPAPER:-$HOME/.hacklock/wallpaper.jpg}"

show_help() {
  cat <<'EOF'
HACK-LOCK - a simple visual skin for Termux on Android.
It never replaces Termux: every normal command keeps working.

USAGE
  hacklock             apply the skin (green theme + wallpaper header)
  hacklock --help      show this help
  hacklock --version   show version
  hacklock --config    show config file and current values

CONFIG      ~/.hacklock/config/config.sh
WALLPAPER   ~/.hacklock/wallpaper.jpg   (replace the file, run 'hacklock')

UNINSTALL   bash ~/.hacklock/uninstall.sh
EOF
}

show_config() {
  echo "Config:     $CONFIG_FILE"
  echo "Wallpaper:  $HACKLOCK_WALLPAPER"
  echo
  if [ -f "$CONFIG_FILE" ]; then
    sed 's/^/  /' "$CONFIG_FILE"
  else
    echo "  (config not found - re-run install.sh)"
  fi
}

# Print the wallpaper as a full-width header, preserving its aspect ratio.
# Width is read live from the terminal; height follows the image's own
# proportions (no stretching, no cropping).
render_header() {
  local img="$HACKLOCK_WALLPAPER"
  [ -f "$img" ] || { echo "[HACK-LOCK] wallpaper not found: $img" >&2; return 0; }

  # Always detect the current terminal width.
  local cols dims iw ih rows size cap xy
  cols=$(tput cols 2>/dev/null)
  [ -n "$cols" ] || cols=80

  # Learn the image pixel size when possible, so very tall images can still
  # be kept compact. chafa preserves the aspect ratio in every case below.
  dims=""
  if command -v identify >/dev/null 2>&1; then
    dims=$(identify -format "%w %h" "$img" 2>/dev/null)
  fi
  if [ -z "$dims" ] && command -v file >/dev/null 2>&1; then
    xy=$(file "$img" 2>/dev/null | grep -oiE '[0-9]+[[:space:]]*x[[:space:]]*[0-9]+' | tail -n1 | tr -d ' ')
    [ -n "$xy" ] && dims="${xy%x*} ${xy#*x}"
  fi

  # Width-only size: chafa computes the height from the image's aspect ratio.
  size="${cols}x"
  rows=""

  if [ -n "$dims" ]; then
    iw="${dims%% *}"; ih="${dims##* }"
    if [ "${iw:-0}" -gt 0 ]; then
      # A terminal cell is about twice as tall as it is wide, hence /2.
      rows=$(( (cols * ih) / (iw * 2) + 1 ))
      cap="${HACKLOCK_HEADER_HEIGHT:-0}"
      if [ "$cap" -gt 0 ]; then
        [ "$rows" -gt "$cap" ] && rows="$cap"
      elif [ "$rows" -gt 20 ]; then
        rows=20
      fi
      [ "$rows" -lt 3 ] && rows=3
      size="${cols}x${rows}"
    fi
  fi

  if command -v chafa >/dev/null 2>&1; then
    chafa --format symbols --colors full --size "$size" "$img" 2>/dev/null \
      || chafa --format symbols --colors 256 --size "$size" "$img" 2>/dev/null \
      || { [ "${rows:-0}" -gt 0 ] && \
           chafa --format symbols --colors 256 --size "${cols}x${rows}" "$img" 2>/dev/null; } \
      || chafa --format symbols --size "$size" "$img" 2>/dev/null \
      || true
  elif command -v jp2a >/dev/null 2>&1; then
    jp2a --colors --width="$cols" "$img" 2>/dev/null || true
  else
    echo "[HACK-LOCK] install chafa to show the wallpaper:  pkg install chafa" >&2
  fi
}

apply_skin() {
  # Only touch a real terminal.
  [ -t 1 ] || return 0

  # Black background, green text, green cursor (applied live to the terminal).
  printf '\033]10;%s\007' "$HACKLOCK_GREEN"
  printf '\033]11;#000000\007'
  printf '\033]12;%s\007' "$HACKLOCK_GREEN"

  render_header
}

case "${1:-}" in
  --help|-h)     show_help ;;
  --version|-v)  echo "hacklock $HACKLOCK_VERSION" ;;
  --config)      show_config ;;
  *)             apply_skin ;;
esac
exit 0